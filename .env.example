# Backend Environment Configuration
PROJECT_NAME="Somalìa Risk PoC Backend"
API_V1_STR="/api/v1"
SECRET_KEY="dev_secret_key_change_in_production"
# Token custodito dal gestore della piattaforma per inizializzare un account HR per nuova azienda.
HR_BOOTSTRAP_TOKEN=""
AUTH_TOKEN_MINUTES=480
# In produzione usare una chiave casuale distinta da SECRET_KEY.
PSEUDO_KEY="chiave_segreta_hmac_sanita_privata_demo"
# Solo per sviluppo locale. Su Vercel usare DATABASE_URL PostgreSQL persistente (es. Neon).
DATABASE_URL="sqlite:///./Somalìa.db"
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Privacy & Compliance
K_MIN=6
RETENTION_MESI=24
AVVISI_ORARIO_HR=false
COSTO_TURNOVER_DEFAULT=45000.0
